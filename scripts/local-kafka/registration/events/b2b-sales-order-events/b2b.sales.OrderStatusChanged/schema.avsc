    {
      "name": "status",
      "type": {
        "type": "enum",
        "name": "StatusCode",
        "doc": "Represents the status code of the Sales Order in any of the systems * DEACTIVATED: 050 DES Preparation for the order deactivated * NOT_RUN: 100 NLA No data to run preparation for the order * RUN: 200 LAN Preparation for the order is run * COLLECTION_STARTED: 300 RDE Collection is started * COLLECTION_PERFORMED: 350 REF Collection is performed * PREPARATION_IN_PROGRESS: 400 PEC Preparation for the order is in progress * TO_PACKAGE: 500 TTR Preparation for the order needs to get packaging operation * COMPLETED: 550 TER Preparation for the order is completed * DESPATCHED: 600 EXP Preparation for the order has been despatched * CANCELLED: 650 ANN Preparation for the order is cancelled (used in ERP to unlock order deletion) * DELETED: Order is deleted in ERP system * ORDER_CANCELED: Order is fully canceled in ERP system and the status is used to change order display on UI * CREDIT_BLOCKED: Order is blocked for further processing due to customer credit limit exceeding * CREDIT_UNBLOCKED: Order is unblocked for further processing after resolving customer credit limit exceeding",
        "symbols": [
          "UNKNOWN",
          "DEACTIVATED",
          "NOT_RUN",
          "RUN",
          "COLLECTION_STARTED",
          "COLLECTION_PERFORMED",
          "PREPARATION_IN_PROGRESS",
          "TO_PACKAGE",
          "COMPLETED",
          "DESPATCHED",
          "CANCELLED",
          "DELETED",
          "ORDER_CANCELED",
          "CREDIT_BLOCKED",
          "CREDIT_UNBLOCKED"
        ],
        "default": "UNKNOWN"
      },
      "doc": "Current order status"
    },
    {
      "name": "warehouseCode",
      "type": "string",
      "doc": "Warehouse code/physical location of goods"
    },
    {
      "name": "isReturn",
      "type": [
        "null",
        "boolean"
      ],
      "doc": "A flag indicating return or an order for filtering purposes. TEMPORARY FIELD, to be decommissioned after new return specific event is developed.",
      "default": null
    },
    {
      "name": "changeDate",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Status change date"
    },
    {
