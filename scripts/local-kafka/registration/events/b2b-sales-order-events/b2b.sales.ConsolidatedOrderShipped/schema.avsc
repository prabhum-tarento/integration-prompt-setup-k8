    {
      "name": "parentOrderId",
      "type": "string",
      "doc": "Parent Sales Order identifier under which several orders were consolidated into a common shipment (chosen among them)"
    },
    {
      "name": "shipment",
      "type": {
        "type": "record",
        "name": "Shipment",
        "doc": "B2B sales shipment",
        "fields": [
          {
            "name": "id",
            "type": "string",
            "doc": "Unique identifier for the shipment. Also referred to as preparation identifier in warehouse processes."
          },
          {
            "name": "warehouseCode",
            "type": "string",
            "doc": "Shipment warehouse"
          },
          {
            "name": "confirmationType",
            "type": {
              "type": "enum",
              "name": "ConfirmationType",
              "doc": "A type of shipment confirmation",
              "symbols": [
                "UNKNOWN",
                "PRELIMINARY",
                "STANDARD",
                "STANDARD_FOLLOWING_PRELIMINARY",
                "PRELIMINARY_INVOICE",
                "PRELIMINARY_EXPORT"
              ],
              "default": "UNKNOWN"
            },
            "doc": "Represents the type of shipment confirmation"
          },
          {
            "name": "shipDate",
            "type": {
              "type": "long",
              "logicalType": "timestamp-millis"
            },
            "doc": "Actual shipment date"
          },
          {
            "name": "deliveryMode",
            "type": "string",
            "doc": "The Mode of delivery (e.g. \"DHL\")"
          },
          {
            "name": "deliveryReason",
            "type": "string",
            "doc": "Delivery reason (e.g. \"BBX\")"
          },
          {
            "name": "shipmentLines",
            "type": {
              "type": "array",
              "items": {
                "type": "record",
                "name": "ShipmentLine",
                "doc": "B2B shipment line",
                "fields": [
                  {
                    "name": "lineNum",
                    "type": "string",
                    "doc": "Unique identifier for the shipment line item"
                  },
                  {
                    "name": "pickingRouteId",
                    "type": "string",
                    "doc": "Unique identifier for the warehouse picking route"
                  },
                  {
                    "name": "preparationLineNum",
                    "type": "long",
                    "doc": "Unique identifier for lineNum, orderId and trackingNumber"
                  },
                  {
                    "name": "trackingNumber",
                    "type": [
                      "null",
                      "string"
                    ],
                    "doc": "Unique Identifier for the shipment (to match with CartonDetail)",
                    "default": null
                  },
                  {
                    "name": "orderId",
                    "type": "string",
                    "doc": "Initial Sales Order identifier linked to the line"
                  },
                  {
                    "name": "lotId",
                    "type": "string",
                    "doc": "Unique identifier of the item line in source system"
                  },
                  {
                    "name": "productId",
                    "type": "string",
                    "doc": "The product identifier"
                  },
                  {
                    "name": "quantity",
                    "type": "int",
                    "doc": "Line quantity"
                  },
                  {
                    "name": "hallmarking",
                    "type": [
                      "null",
                      "string"
                    ],
                    "doc": "Market-specific hallmarking type of the item. NON refers to absent hallmarking",
                    "default": null
                  },
                  {
                    "name": "allocatedFromB2BBucketQuantity",
                    "type": [
                      "null",
                      "int"
                    ],
                    "doc": "This is the quantity that was taken from the B2B bucket for allocating to the order",
                    "default": null
                  },
                  {
                    "name": "allocatedFromB2CBucketQuantity",
                    "type": [
                      "null",
                      "int"
                    ],
                    "doc": "It represents the quantity that was taken from the B2C bucket for allocating to the order",
                    "default": null
                  },
                  {
                    "name": "isBonded",
                    "type": [
                      "null",
                      "boolean"
                    ],
                    "doc": "It represents whether quantity is shipped from the bonded warehouse inventory",
                    "default": null
                  },
                  {
                    "name": "countryOfOrigin",
                    "type": [
                      "null",
                      "net.pandora.nexus.shared.CountryCode"
                    ],
                    "doc": "The country of purchase origin",
                    "default": null
                  },
                  {
                    "name": "weight",
                    "type": {
                      "type": "record",
                      "name": "Weight",
                      "namespace": "net.pandora.nexus.shared",
                      "doc": "Standard type for specifying weight.",
                      "fields": [
                        {
                          "name": "unit",
                          "type": {
                            "type": "enum",
                            "name": "WeightUnit",
                            "doc": "Standard units of weight measurement.",
                            "symbols": [
                              "UNKNOWN",
                              "MILLIGRAM",
                              "GRAM",
                              "KILOGRAM",
                              "CARAT"
                            ],
                            "default": "UNKNOWN"
                          },
                          "doc": "Unit of this weight measurement."
                        },
                        {
                          "name": "quantity",
                          "type": "int",
                          "doc": "Number of the associated units in this measurement."
                        }
                      ]
                    },
                    "doc": "Represents weight of the item"
                  },
                  {
                    "name": "inventoryRegistrationId",
                    "type": [
                      "null",
                      "string"
                    ],
                    "doc": "Registration number issued by the customs authority after the registration of the corresponding inbound shipment is completed",
                    "default": null
                  },
                  {
                    "name": "customsRegistrationLineNum",
                    "type": [
                      "null",
                      "string"
                    ],
                    "doc": "Line number in the registration document issued by the customs authority after the registration of the corresponding inbound shipment is completed",
                    "default": null
                  },
                  {
                    "name": "itemCategoryLocalized",
                    "type": [
                      "null",
                      "string"
                    ],
                    "doc": "Local translation of the item category, required by local customs for registration of inbound shipments in bonded warehouse",
                    "default": null
                  },
                  {
                    "name": "itemMaterialName",
                    "type": [
                      "null",
                      "string"
                    ],
                    "doc": "English translation of the metal used in the item, required by local customs for registration of inbound shipments in bonded warehouse",
                    "default": null
                  },
                  {
                    "name": "itemMaterialNameLocalized",
                    "type": [
                      "null",
                      "string"
                    ],
                    "doc": "Local translation of the metal used in the item, required by local customs for registration of inbound shipments in bonded warehouse",
                    "default": null
                  },
                  {
                    "name": "mainInventoryRegistrationId",
                    "type": [
                      "null",
                      "string"
                    ],
                    "doc": "Registration number issued by the main customs authority after the registration of the corresponding inbound shipment is completed",
                    "default": null
                  },
                  {
                    "name": "mainCustomsRegistrationLineNum",
                    "type": [
                      "null",
                      "string"
                    ],
                    "doc": "Line number in the registration document issued by the main customs authority after the registration of the corresponding inbound shipment is completed",
                    "default": null
                  }
                ]
              }
            },
            "doc": "Shipment lines",
            "default": []
          },
          {
            "name": "packingSlipId",
            "type": "string",
            "doc": "Represents Packing Slip identifier"
          },
          {
            "name": "cartonDetails",
            "type": {
              "type": "array",
              "items": {
                "type": "record",
                "name": "CartonDetail",
                "doc": "Represents information about parcel.",
                "fields": [
                  {
                    "name": "cartonId",
                    "type": "string",
                    "doc": "Unique Identifier for the shipment carton."
                  },
                  {
                    "name": "externalTrackingNumber",
                    "type": [
                      "null",
                      "string"
                    ],
                    "doc": "Consignment unit identifier, also used as external tracking identifier by transport/shipping courier companies such as DHL, UPS, etc.",
                    "default": null
                  },
                  {
                    "name": "weight",
                    "type": "net.pandora.nexus.shared.Weight",
                    "doc": "Represents parcel weight"
                  },
                  {
                    "name": "height",
                    "type": {
                      "type": "record",
                      "name": "Length",
                      "namespace": "net.pandora.nexus.shared",
                      "doc": "Standard type for specifying length or distance.",
                      "fields": [
                        {
                          "name": "unit",
                          "type": {
                            "type": "enum",
                            "name": "LengthUnit",
                            "doc": "Standard units of length measurement.",
                            "symbols": [
                              "UNKNOWN",
                              "MILLIMETER",
                              "CENTIMETER",
                              "METER"
                            ],
                            "default": "UNKNOWN"
                          },
                          "doc": "Unit of this distance measurement."
                        },
                        {
                          "name": "quantity",
                          "type": "int",
                          "doc": "Number of the associated units in this measurement."
                        }
                      ]
                    },
                    "doc": "Represents parcel height"
                  },
                  {
                    "name": "width",
                    "type": "net.pandora.nexus.shared.Length",
                    "doc": "Represents parcel width"
                  },
                  {
                    "name": "depth",
                    "type": "net.pandora.nexus.shared.Length",
                    "doc": "Represents parcel depth"
                  }
                ]
              }
            },
            "doc": "Represents information about parcels",
            "default": []
          },
          {
            "name": "rootReference",
            "type": [
              "null",
              "string"
            ],
            "doc": "Also referred to as StammReferenzen. An identifier sent by Pandora Systems to let the German customs system know which pre-filled meta data to be used for a particular shipment",
            "default": null
          },
          {
            "name": "bondedWarehouseScenario",
            "type": [
              "null",
              {
                "type": "enum",
                "name": "BondedWarehouseScenario",
                "namespace": "net.pandora.nexus.shared",
                "doc": "Scenario for the bonded warehose if applicable: * EU - European Union only * EXPORT_IMPORT - Export with import * EXPORT_NO_IMPORT - Export without import",
                "symbols": [
                  "UNKNOWN",
                  "EU",
                  "EXPORT_IMPORT",
                  "EXPORT_NO_IMPORT"
                ],
                "default": "UNKNOWN"
              }
            ],
            "doc": "Scenario for the bonded warehose",
            "default": null
          },
          {
            "name": "grossWeight",
            "type": [
              "null",
              "net.pandora.nexus.shared.Weight"
            ],
            "doc": "Total weight of the shipment. Use case: covering the weight of one or multiple consolidated orders on the same shipment",
            "default": null
          }
        ]
      },
      "doc": "Order shipment terms"
    },
    {
      "name": "orderCharges",
      "type": {
        "type": "array",
