                    "type": {
                      "type": "array",
                      "items": "string"
                    },
                    "doc": "An address line is one physical or logical line of an address, typically containing undifferentiated portions of an address such as street addresses, post box numbers, building numbers, mailstops, etc.",
                    "default": []
